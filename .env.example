# Copy to .env.local and fill in your real values.
# These power the "Find a dealer" lead form, which POSTs to your PGAK ERP.
# NOTE: NEXT_PUBLIC_* vars are embedded in the browser bundle (visible to anyone).
# This matches the original static site. Rotate the secret periodically, or move
# lead submission behind a Next.js server route if it must stay hidden.

NEXT_PUBLIC_ERP_ENDPOINT=https://erp.pgak.co.in/api/leads/inbound
NEXT_PUBLIC_WEBHOOK_SECRET=replace-with-your-webhook-secret

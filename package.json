    "test:middleware": "node --experimental-strip-types --test lib/spamUrls.test.ts",
    "test:leads": "node --experimental-strip-types --test lib/leads.test.ts",
    "test": "npm run test:middleware && npm run test:leads",
    "test:analytics": "node --test scripts/test-analytics.cjs",
    "typecheck": "tsc --noEmit",
    "test:lead-client": "node --test scripts/test-lead-client.cjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^11.5.6",

    "hls.js": "^1.6.17",
    "lenis": "^1.3.25",
    "marked": "^18.0.7",
    "next": "15.5.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.24",
    "postcss": "8.5.28",

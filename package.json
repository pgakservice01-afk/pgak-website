{
  "name": "pgak-website",
  "version": "1.0.0",
  "private": true,
  "description": "PGAK \u2014 Intelligent Security marketing site. Next.js 14 scrollytelling rebuild.",
  "scripts": {
    "dev": "next dev",
    "mock:cloud": "node scripts/mock-cloud.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "optimize:images": "node scripts/optimize-images.mjs",
